# The gate (docs/spec.md §9): `make check` runs every step, and CI runs the same. Each step is
# also a target of its own.

GOLANGCI_LINT_VERSION := 2.15.0
GOVULNCHECK_VERSION := v1.9.0

BIN := node_modules/.bin

# Short fuzz runs in the gate: package:target pairs, each for FUZZTIME.
FUZZ := ./workflow:FuzzLoad ./workflow:FuzzFill
FUZZTIME := 10s

# Every generated file that is committed, regenerated by `make fixtures`. The generator's golden
# files are rewritten by `go test ./cmd/tscomfy-go -update`.
GENERATED := ts/test/comfy examples/txt2img/workflows/comfy examples/txt2img/internal/workflows \
	workflow/testdata/cross-language.json

.PHONY: check gofmt vet lint test fuzz vuln tsc oxlint oxfmt bun-test e2e fixtures

# The steps run in order: the end-to-end check rewrites files that other steps read.
.NOTPARALLEL:

check: gofmt vet lint test fuzz vuln tsc oxlint oxfmt bun-test e2e

gofmt:
	@out="$$(find . -name node_modules -prune -o -name '*.go' -print | xargs -r gofmt -l)"; \
	if [ -n "$$out" ]; then echo "gofmt: these files need formatting:"; echo "$$out"; exit 1; fi

vet:
	go vet ./...

lint:
	@found="$$(golangci-lint version --short 2>/dev/null)"; \
	if [ "$$found" != "$(GOLANGCI_LINT_VERSION)" ]; then \
		echo "lint: golangci-lint $(GOLANGCI_LINT_VERSION) required, found $${found:-none}"; exit 1; \
	fi
	golangci-lint run

test:
	go test -race -shuffle=on ./...

fuzz:
	@for f in $(FUZZ); do \
		go test -run='^$$' -fuzz="^$${f#*:}$$" -fuzztime=$(FUZZTIME) "$${f%%:*}" || exit 1; \
	done

vuln:
	go run golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VERSION) ./...

node_modules: package.json bun.lock
	bun install --frozen-lockfile
	@touch node_modules

tsc: node_modules
	$(BIN)/tsc -b

oxlint: node_modules
	$(BIN)/oxlint --type-aware

oxfmt: node_modules
	$(BIN)/oxfmt --check

bun-test: node_modules
	bun test --conditions=@tscomfy/source --pass-with-no-tests

# The end-to-end check (docs/spec.md §9): regenerating every generated file from its source, the
# example's Go included, changes nothing, and the example builds.
e2e: tsc
	@snapshot="$$(mktemp -d)"; trap 'rm -rf "$$snapshot"' EXIT; \
	for path in $(GENERATED); do mkdir -p "$$snapshot/$$(dirname "$$path")" && cp -R "$$path" "$$snapshot/$$path" || exit 1; done; \
	$(MAKE) --no-print-directory fixtures || exit 1; \
	go build ./examples/... || exit 1; \
	for path in $(GENERATED); do \
		diff -r "$$snapshot/$$path" "$$path" >/dev/null || { echo "e2e: $$path was stale; it is regenerated now: commit it"; exit 1; }; \
	done

# Regenerates the committed generated files: the test and example schemas from their mocks, the
# cross-language fixture, and the example's Go. The export runs the built package: tsc first.
fixtures: tsc
	cd ts/test/comfy && for schema in basic-pipeline params; do \
		../../../$(BIN)/tscomfy generate --from ../../../testdata/object-info/$$schema.json --out $$schema --import-extension .ts --quiet || exit 1; \
	done
	cd examples/txt2img/workflows && bun run schema
	bun --conditions=@tscomfy/source ts/test/update-fixtures.ts
	go generate ./examples/...
